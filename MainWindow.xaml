<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Margin="14" CornerRadius="18" Background="#14161B" BorderBrush="#262A33" BorderThickness="1"
        TextElement.Foreground="#E8EAEE" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.FontSize="13">
  <Border.Effect>
    <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="Black"/>
  </Border.Effect>
  <Border.Resources><!--THEME--></Border.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False">
        <Border Width="20" Height="20" CornerRadius="6" Background="#2FB36E" Margin="0,0,10,0">
          <TextBlock Text="&#xE765;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Раскладка" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        <TextBlock Text="  by mysik" Foreground="#6E7584" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
        <Button x:Name="MinBtn" Style="{StaticResource TitleBtn}" Content="&#xE921;" ToolTip="Свернуть"/>
        <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" Content="&#xE8BB;" ToolTip="Закрыть"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,4,12">
      <StackPanel Margin="16,0,12,8">

        <!-- главный статус -->
        <Border Background="#1C1F26" CornerRadius="16" Padding="18,16">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="StatusTitle" Text="Работает" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusSub" Text="" Style="{StaticResource Hint}"/>
              </StackPanel>
              <CheckBox x:Name="SwEnabled" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
            </Grid>
            <Border Background="#14161B" CornerRadius="12" Padding="14,12" Margin="0,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ghbdtn" FontFamily="Consolas" FontSize="17" Foreground="#8B92A0" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="#2FB36E"
                           VerticalAlignment="Center" Margin="12,0"/>
                <TextBlock Grid.Column="2" Text="привет" FontFamily="Consolas" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              </Grid>
            </Border>
            <TextBlock x:Name="CounterText" Text="" Style="{StaticResource Hint}" Margin="2,10,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="ГОРЯЧИЕ КЛАВИШИ" Style="{StaticResource Caption}" Margin="4,20,0,0"/>
        <StackPanel x:Name="PresetList" Margin="0,8,0,0"/>

        <Border Style="{StaticResource Card}" Margin="0,4,0,18" Padding="16,12">
          <StackPanel>
            <TextBlock Text="Всегда работают" FontWeight="SemiBold"/>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/>
              </Grid.RowDefinitions>
              <Border Background="#262A33" CornerRadius="7" Padding="8,3" Margin="0,0,12,8" HorizontalAlignment="Left">
                <TextBlock Text="Ctrl + Alt + T" FontFamily="Consolas" FontSize="12"/>
              </Border>
              <TextBlock Grid.Column="1" Text="транслит выделенного: privet ⇄ привет" Foreground="#AEB4C0" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
              <Border Grid.Row="1" Background="#262A33" CornerRadius="7" Padding="8,3" Margin="0,0,12,0" HorizontalAlignment="Left">
                <TextBlock Text="Ctrl + Alt + R" FontFamily="Consolas" FontSize="12"/>
              </Border>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="регистр выделенного: пРИВЕТ → Привет" Foreground="#AEB4C0" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="ПОПРОБУЙ" Style="{StaticResource Caption}"/>
        <Border Style="{StaticResource Card}" Padding="12">
          <StackPanel>
            <TextBox x:Name="TestBox" Style="{StaticResource InputBox}" MinHeight="40"/>
            <TextBlock x:Name="TestHint" Text="" Style="{StaticResource Hint}" Margin="2,8,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="НАСТРОЙКИ" Style="{StaticResource Caption}"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <CheckBox x:Name="SwSwitchLayout" Style="{StaticResource Switch}">
              <StackPanel>
                <TextBlock Text="Переключать раскладку" FontWeight="SemiBold"/>
                <TextBlock Text="После исправления дальше печатается на нужном языке" Style="{StaticResource Hint}"/>
              </StackPanel>
            </CheckBox>
            <Border Style="{StaticResource Separator}"/>
            <CheckBox x:Name="SwAutostart" Style="{StaticResource Switch}">
              <StackPanel>
                <TextBlock Text="Запускать вместе с Windows" FontWeight="SemiBold"/>
                <TextBlock Text="Тихо стартует в трее у часов" Style="{StaticResource Hint}"/>
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Hint}" Margin="4,0,4,4">
          <Run Text="Раскладка"/>
          <Run x:Name="Signature" Text="by mysik" Foreground="#2FB36E" FontWeight="SemiBold" Cursor="Hand"/>
          <Run Text=" · работает в любых программах, кроме запущенных от администратора"/>
        </TextBlock>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="Snack" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="20,0,20,22" Padding="16,11" CornerRadius="12" Background="#2A2E38" BorderBrush="#363B47" BorderThickness="1"
            Opacity="0" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black"/>
      </Border.Effect>
      <TextBlock x:Name="SnackText" Text="" TextWrapping="Wrap" MaxWidth="320"/>
    </Border>

    <Grid x:Name="Overlay" Grid.Row="0" Grid.RowSpan="3" Background="#B30B0C10" Visibility="Collapsed">
      <Border Width="330" Background="#1E2128" CornerRadius="16" Padding="20" BorderBrush="#2E333E" BorderThickness="1"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="DlgTitle" Text="" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="DlgText" Text="" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"/>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DlgNo" Style="{StaticResource SecondaryBtn}" Background="#2A2E38" Content="Отмена"/>
            <Button x:Name="DlgYes" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="OK"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Border>
